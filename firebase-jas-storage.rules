rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /jasWebsiteImages/{page}/{imageId} {
      allow get: if true;
      allow create: if request.auth != null
        && request.auth.uid == 'ydJDSUYmJoWeww9rfrboUQkfnPv1'
        && page.matches('index|about|flight|train|bus|domestic|international|contact')
        && imageId.matches('[0-9a-f-]{36}')
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif)');
    }
  }
}
